        "class MnistSumSequenceDataset(Dataset):\n",
        "    def __init__(self, images, labels, max_to_add=8, seed=2018):\n",
        "        self.images = images\n",
        "        self.labels = labels\n",
        "        self.max_to_add = max_to_add\n",
        "        self.n_samples = images.shape[0]\n",
        "\n",
        "        rng = np.random.RandomState(seed)\n",
        "        self.seq_indices = []\n",
        "        self.targets = np.zeros((self.n_samples, 1), dtype=np.float32)\n",
