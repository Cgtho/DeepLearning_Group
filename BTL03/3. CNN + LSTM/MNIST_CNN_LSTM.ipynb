    "# Sau 3 lần MaxPool2d(2, 2) trên ảnh 28x28: 28 -> 14 -> 7 -> 3, với 256 channels => 256 * 3 * 3 = 2304\n",
    "class MnistCnnLstm(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.cnn_block = nn.Sequential(\n",
    "            nn.Conv2d(1, 64, kernel_size=3, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.MaxPool2d(kernel_size=2),\n",
    "            nn.Dropout2d(0.2),\n",
    "\n",
    "            nn.Conv2d(64, 128, kernel_size=3, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.MaxPool2d(kernel_size=2),\n",
    "            nn.Dropout2d(0.2),\n",
    "\n",
    "            nn.Conv2d(128, 256, kernel_size=3, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.MaxPool2d(kernel_size=2),\n",
    "            nn.Dropout2d(0.2),\n",
    "\n",
    "            nn.Flatten()\n",
    "        )\n",
    "        cnn_out_dim = 256 * 3 * 3\n",
    "        self.lstm1 = nn.LSTM(input_size=cnn_out_dim, hidden_size=128, batch_first=True)\n",
    "        self.lstm2 = nn.LSTM(input_size=128, hidden_size=128, batch_first=True)\n",
    "        self.lstm_dropout = nn.Dropout(0.22)\n",
    "        self.fc_out = nn.Linear(128, 1)\n",
    "\n",
    "    def forward(self, x):\n",
    "        # x: (B, T, C, H, W)\n",
    "        b, t, c, h, w = x.shape\n",
    "        x_flat = x.view(b * t, c, h, w)\n",
    "        cnn_feat = self.cnn_block(x_flat)          # (B*T, 2304)\n",
    "        seq_feat = cnn_feat.view(b, t, -1)         # (B, T, 2304)\n",
    "        out1, _ = self.lstm1(seq_feat)            # (B, T, 128)\n",
    "        out2, _ = self.lstm2(out1)               # (B, T, 128)\n",
    "        last_step = self.lstm_dropout(out2[:, -1, :])\n",
    "        return self.fc_out(last_step)\n",
    "\n",
    "model = MnistCnnLstm().to(device)\n",
    "print(model)\n",
    "print(\"Total trainable params:\", sum(p.numel() for p in model.parameters() if p.requires_grad))"
   ]
