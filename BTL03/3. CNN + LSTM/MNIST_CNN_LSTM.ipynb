        "lr = 0.01\n",
        "epochs = 5\n",
        "criterion = nn.L1Loss()  # mean_absolute_error\n",
        "optimizer = torch.optim.SGD(model.parameters(), lr=lr)\n",
        "\n",
        "history = {\"train_mae\": [], \"val_mae\": []}\n",
        "starting_time = time.time()\n",
        "\n",
        "for epoch in range(1, epochs + 1):\n",
        "    model.train()\n",
        "    tr_loss, tr_total = 0.0, 0\n",
        "    for bx, by in train_loader:\n",
        "        bx, by = bx.to(device), by.to(device)\n",
        "        optimizer.zero_grad()\n",
        "        preds = model(bx)\n",
        "        loss = criterion(preds, by)\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "\n",
        "        tr_loss += loss.item() * by.size(0)\n",
        "        tr_total += by.size(0)\n",
        "\n",
        "    model.eval()\n",
        "    val_loss, val_total = 0.0, 0\n",
        "    with torch.no_grad():\n",
        "        for bx, by in test_loader:\n",
        "            bx, by = bx.to(device), by.to(device)\n",
        "            preds = model(bx)\n",
        "            loss = criterion(preds, by)\n",
        "            val_loss += loss.item() * by.size(0)\n",
        "            val_total += by.size(0)\n",
        "\n",
        "    epoch_tr_mae = tr_loss / tr_total\n",
        "    epoch_val_mae = val_loss / val_total\n",
        "    history[\"train_mae\"].append(epoch_tr_mae)\n",
        "    history[\"val_mae\"].append(epoch_val_mae)\n",
        "\n",
        "    print(f\"Epoch {epoch:02d}/{epochs:02d} - loss (MAE): {epoch_tr_mae:.4f} - val_loss (MAE): {epoch_val_mae:.4f}\")\n",
        "\n",
        "print(\"> training time is %.4f minutes\" % ((time.time() - starting_time) / 60))"
      ]
    },
