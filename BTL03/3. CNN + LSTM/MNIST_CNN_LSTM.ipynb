   "outputs": [],
   "source": [
    "# Demo",
    "\n",
    "# MNIST dataset",
    "- MNIST dataset",
    "  + Goal: estimating summation of handwritten digit images",
    "  + Input: a set of 28x28 images",
    "  + Output: summation of given handwritten digit images",
    "- Defining an CNN+LSTM for MNIST dataset",
    "- Training and evaluating an CNN+LSTM"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Import libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torch.utils.data import DataLoader, TensorDataset\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# PyTorch CNN+LSTM model",
    "from torch.optim import SGD\n",
    "\n",
    "# For loading MNIST",
    "from torchvision import datasets, transforms\n",
    "\n",
    "# Set random seed for reproducibility",
    "torch.manual_seed(42)\n",
    "np.random.seed(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# (1) Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load MNIST data",
    "transform = transforms.Compose([transforms.ToTensor(), transforms.Normalize((0.5,), (0.5,))])\n",
    "train_dataset = datasets.MNIST(root='./data', train=True, download=True, transform=transform)\n",
    "test_dataset = datasets.MNIST(root='./data', train=False, download=True, transform=transform)\n",
    "\n",
    "# Create data loaders - the CNN+LSTM expects sequences of images",
    "batch_size = 128\n",
    "n_images_per_set = 8  # number of images per summation set\n",
    "\n",
    "# Custom collate function to group images into sets",
    "def collate_fn(batch):\n",
    "    images, labels = zip(*batch)\n",
    "    # images: list of (1, 28, 28) tensors\n",
    "    # Stack and reshape to (batch*n_images, 1, 28, 28)\n",
    "    all_images = torch.stack([img for img_set in images for img in img_set])\n",
    "    # Reshape to (batch, n_images, 1, 28, 28)\n",
    "    batch_size = len(images)\n",
    "    all_images = all_images.view(batch_size, n_images_per_set, 1, 28, 28)\n",
    "    labels = torch.stack(labels)\n",
    "    return all_images, labels\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True, collate_fn=collate_fn)\n",
    "test_loader = DataLoader(test_dataset, batch_size=batch_size, shuffle=False, collate_fn=collate_fn)\n",
    "\n",
    "# Show data shape",
    "for images, labels in train_loader:\n",
    "    print('x_train shape:', images.shape)\n",
    "    print(images.shape[0], 'train samples')\n",
    "    break"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# (2) Model definition"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# CNN+LSTM model for MNIST summation",
    "class CNN_LSTM(nn.Module):\n",
    "    def __init__(self):\n",
    "        super(CNN_LSTM, self).__init__()\n",
    "        # CNN feature extractor",
    "        self.conv = nn.Sequential(\n",
    "            nn.Conv2d(1, 32, kernel_size=3, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.MaxPool2d(2, 2),  # 14x14\n",
    "            nn.Conv2d(32, 64, kernel_size=3, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.MaxPool2d(2, 2)   # 7x7\n",
    "        )\n",
    "        # After CNN, each image gives 64*7*7 = 3136 features",
    "        # LSTM processing sequence of 8 CNN features",
    "        self.lstm = nn.LSTM(input_size=64*7*7, hidden_size=128, num_layers=1, batch_first=True)\n",
    "        # Final prediction layer",
    "        self.fc = nn.Linear(128, 1)  # Regression: predict summation\n",
    "\n",
    "    def forward(self, x):\n",
    "        # x shape: (batch, 8, 1, 28, 28) - 8 images of 28x28\n",
    "        batch_size = x.size(0)\n",
    "\n",
    "        # Process each image through CNN",
    "        # Reshape to (batch*8, 1, 28, 28) for CNN",
    "        cnn_input = x.view(batch_size * 8, 1, 28, 28)\n",
    "        cnn_features = self.conv(cnn_input)\n",
    "        # Flatten CNN features",
    "        cnn_features = cnn_features.view(-1, 64 * 7 * 7)\n",
    "        # Reshape for LSTM: (batch, 8, 64*7*7)",
    "        lstm_input = cnn_features.view(batch_size, 8, 64 * 7 * 7)\n",
    "        # LSTM forward",
    "        lstm_out, (hn, cn) = self.lstm(lstm_input)\n",
    "        # Use the last timestep's output",
    "        last_lstm_out = lstm_out[:, -1, :]\n",
    "        # Final fully connected layer",
    "        output = self.fc(last_lstm_out)\n",
    "        return output\n",
    "\n",
    "# Initialize model, loss, and optimizer",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "model = CNN_LSTM().to(device)\n",
    "criterion = nn.L1Loss()  # Mean Absolute Error for summation",
    "optimizer = SGD(model.parameters(), lr=0.01, momentum=0.9)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Training loop",
    "num_epochs = 30\n",
    "batch_size = 128\n",
    "\n",
    "for epoch in range(num_epochs):\n",
    "    model.train()\n",
    "    running_loss = 0.0\n",
    "    for i, (images, labels) in enumerate(train_loader):\n",
    "        images, labels = images.to(device), labels.to(device)\n",
    "\n",
    "        # Forward pass",
    "        outputs = model(images)\n",
    "        loss = criterion(outputs, labels.float().unsqueeze(1))\n",
    "\n",
    "        # Backward and optimize",
    "        optimizer.zero_grad()\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "        running_loss += loss.item()\n",
    "\n",
    "        if (i + 1) % 100 == 0:\n",
    "            print[f'Epoch [{epoch+1}/30], Step [{i+1}/{(len(train_dataset)//batch_size)}], Loss: {running_loss / 100:.4f}']\n",
    "            running_loss = 0.0\n",
    "\n",
    "    print(f'Epoch [{epoch+1}/30] completed')\n",
    "\n",
    "# Print training time",
    "start_time = time.time()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test the model",
    "model.eval()\n",
    "with torch.no_grad():\n",
    "    total_loss = 0.0\n",
    "    total_samples = 0\n",
    "    for images, labels in test_loader:\n",
    "        images, labels = images.to(device), labels.to(device)\n",
    "        outputs = model(images)\n",
    "        loss = criterion(outputs, labels.float().unsqueeze(1))\n",
    "        total_loss += loss.item() * images.size(0)\n",
    "        total_samples += images.size(0)\n",
    "\n",
    "print(f'Mean absolute error of testing set: {total_loss / total_samples:.6f}')"
   ]
  }
 ]
}