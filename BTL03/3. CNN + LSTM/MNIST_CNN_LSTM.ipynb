        "        seq = torch.zeros((self.max_to_add, 1, size, size), dtype=np.float32)\n",
        "        seq[:len(idx), 0, :, :] = self.images[idx]\n",
        "        target = torch.tensor(self.targets[index], dtype=torch.float32)\n",
        "        return seq, target\n",
        "\n",
        "train_dataset = MnistSumSequenceDataset(X_train_raw, y_train_temp, max_to_add=maxToAdd, seed=2018)\n",
